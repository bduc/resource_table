<%# Locals: column, record, presenter %>
<td data-column="<%= column.name %>" class="text-center">
  <% if ResourceCore::Value.raw(record, column.name) %>
    <span aria-label="<%= t("resource_table.yes", default: "ja") %>">✓</span>
  <% else %>
    <span class="text-base-content/30" aria-label="<%= t("resource_table.no", default: "nee") %>">–</span>
  <% end %>
</td>
