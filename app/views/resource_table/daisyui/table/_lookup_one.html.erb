<%#
  Locals: column, record, presenter

  ResourceCore.lookup_label, not ResourceForm.lookup_label: the latter belongs
  to the form engine and is a one-line delegation to the former, so both
  renderers already share the same label logic without this engine depending
  on resource_form.
%>
<td data-column="<%= column.name %>"
    class="<%= "text-right" if column.align == :right %><%= " text-center" if column.align == :center %>">
  <% associated = ResourceCore::Value.raw(record, column.name) %>
  <% if presenter.overridden?(column) %>
    <%= presenter.cell(column, record) %>
  <% elsif associated %>
    <% if (url = presenter.record_url(associated)) %>
      <%= link_to ResourceCore.lookup_label(associated), url, class: "link link-hover" %>
    <% else %>
      <%= ResourceCore.lookup_label(associated) %>
    <% end %>
  <% else %>
    <%= presenter.cell(column, record) %>
  <% end %>
</td>
